# No secrets in this file. Configure paths to local protected files.
HAPI_API_URL=http://127.0.0.1:3006
HAPI_ACCESS_TOKEN_FILE=/etc/hapi-copilot/hapi-access-token
HAPI_OPERATOR_POLICY_FILE=/etc/hapi-copilot/operator-policy.json
HAPI_COPILOT_STATE_DIR=/var/lib/hapi-copilot/state
# Keep legacy ledger/configuration paths if migrating from previous console:
HAPI_CONSOLE_STATE_DIR=/var/lib/hapi-copilot/legacy-state
HAPI_CONSOLE_POLICY_FILE=/etc/hapi-copilot/legacy-policy.json
HAPI_CONSOLE_ENABLE_WRITES=0
# Only for an intentionally protected private HTTP network, not the Internet:
# HAPI_ALLOW_HTTP_NONLOCAL=1
